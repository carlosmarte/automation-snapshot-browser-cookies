{
  "name": "automation-snapshot-browser-cookies",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "bin": {
    "snapshot-browser-cookies": "./main.mjs"
  },
  "scripts": {
    "start": "mkdir -p ./reports && node main.mjs",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:sauce": "saucectl run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@playwright/test": "1.52.0",
    "@thinkeloquent/cli-progressor": "^1.0.0",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "filenamify-url": "^3.1.0",
    "playwright": "1.52.0",
    "web-vitals": "^5.0.3"
  },
  "optionalDependencies": {
    "saucectl": "^0.195.2"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "extensionsToTreatAsEsm": [
      ".js",
      ".mjs"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "testMatch": [
      "**/*.test.mjs"
    ]
  }
}
